#!/bin/bash
# sudo-elevation grant - root-side helper that opens a time-boxed sudo lease.
#
# Runs as root, normally via `sudo -A .../grant` from `sudo-elevation request`
# (GUI flow) or via `sudo .../grant --minutes N` (terminal/headless flow).
#
# It rewrites the managed sudoers drop-in with the chosen timestamp_timeout
# and schedules a restore back to the configured base timeout.
set -euo pipefail

SELF_DIR=$(cd "$(dirname "$0")" && pwd)
# shellcheck source=common.sh
. "$SELF_DIR/common.sh"

usage() {
	echo "usage: grant --user USER (--minutes N | --choice-file FILE)" >&2
	echo "       [--request-file FILE] [--reason TEXT] [--requested N]" >&2
	echo "       [--config-file FILE]  (user-install: load timeouts from here;" >&2
	echo "                              env does not survive the sudo boundary)" >&2
}

user=""
minutes=""
choice_file=""
request_file=""
reason=""
requested=""
config_file=""

while [ $# -gt 0 ]; do
	case "$1" in
		--user) user=${2-}; shift 2 ;;
		--minutes) minutes=${2-}; shift 2 ;;
		--choice-file) choice_file=${2-}; shift 2 ;;
		--request-file) request_file=${2-}; shift 2 ;;
		--reason) reason=${2-}; shift 2 ;;
		--requested) requested=${2-}; shift 2 ;;
		--config-file) config_file=${2-}; shift 2 ;;
		-h|--help) usage; exit 0 ;;
		*) echo "grant: unknown argument: $1" >&2; usage; exit 2 ;;
	esac
done

[ "$(id -u)" = 0 ] || { echo "grant: must run as root (via sudo)" >&2; exit 1; }
[ -n "$user" ] || user=${SUDO_USER:-}
se_valid_user "$user" || { echo "grant: missing or invalid --user" >&2; exit 2; }
id "$user" >/dev/null 2>&1 || { echo "grant: no such user: $user" >&2; exit 2; }
se_assert_target_user grant "$user" || exit 2

if [ -n "$config_file" ]; then
	# A MISSING config is not an error: every key has a default and se_load_config
	# already tolerates absence. The CLI passes this path unconditionally, so being
	# strict here made `request` fail with "config file not found" the moment someone
	# deleted the file. An EXISTING but untrusted file is still refused.
	if [ -e "$config_file" ] && ! se_config_trusted "$config_file" "$user"; then
		echo "grant: refusing to load $config_file: it must be owned by root" \
			"(and not group/world writable) or by $user" >&2
		exit 2
	fi
	# shellcheck disable=SC2034  # consumed by se_load_config below
	SUDO_ELEVATION_CONFIG=$config_file
fi
se_load_config "$user"

if [ -n "$choice_file" ]; then
	chosen=$(se_read_kv "$choice_file" chosen_minutes || true)
	[ -n "$chosen" ] || { echo "grant: choice file has no chosen_minutes: $choice_file" >&2; exit 3; }
	minutes=$chosen
fi
[ -n "$minutes" ] || { echo "grant: no duration provided" >&2; exit 3; }
se_valid_minutes "$minutes" || {
	echo "grant: duration out of range: $minutes (allowed: 0..$MAX_MINUTES minutes, or -1)" >&2
	exit 3
}

if [ -n "$request_file" ] && [ -f "$request_file" ]; then
	[ -n "$reason" ] || reason=$(se_read_kv "$request_file" reason || true)
	[ -n "$requested" ] || requested=$(se_read_kv "$request_file" requested_minutes || true)
fi
# Strict shape (same class as se_load_config): loose [!0-9.] also let "1.2.3"
# through to audit; fall back to the granted value instead.
case "${requested-}" in ''|*[^0-9.]*|*.*.*|.*|*.) requested=$minutes ;; esac
reason_raw=$reason
reason=$(se_sanitize_reason "$reason")
reason_truncated=0
if [ "${#reason_raw}" -gt 200 ] || case "$reason_raw" in *$'\n'*|*$'\r'*|*$'\t'*) true ;; *) false ;; esac; then
	reason_truncated=1
fi

dest="$SE_SUDOERS_DIR/90-sudo-elevation-$(se_user_slug "$user")"
tmp=$(mktemp "${TMPDIR:-/tmp}/sudo-elevation-sudoers.XXXXXX")
trap 'rm -f "$tmp"' EXIT
se_render_sudoers "$user" "$minutes" "$tmp"
if ! se_install_sudoers "$tmp" "$dest"; then
	echo "grant: failed to validate/install $dest" >&2
	exit 4
fi

now=$(date +%s)
# Unique lease id: second-resolution time is not enough because two leases can
# be granted within the same second, which would defeat the epoch guard.
epoch="${now}-$$-${RANDOM}"
restore_mech="none"
if [ "$minutes" != "-1" ]; then
	restore_mech=$(se_schedule_restore "$user" "$epoch" "$minutes" "${config_file:-$SE_CONFIG}") || restore_mech="failed"
fi

se_write_lease "$(se_lease_file "$user")" "$user" \
	"epoch=$epoch" \
	"user=$user" \
	"minutes=$minutes" \
	"requested_minutes=$requested" \
	"reason=$reason" \
	"granted_at=$(date -Is)" \
	"restore=$restore_mech"

se_audit "grant user=$user minutes=$minutes requested=$requested restore=$restore_mech reason=\"$reason\""

if [ "$minutes" = "-1" ]; then
	printf 'sudo-elevation: 已授权 %s（用 sudo-elevation lock 撤销；sudo -k 仅清缓存，配置仍为无限）\n' \
		"$(se_human_minutes -1)"
else
	secs=$(awk -v m="$minutes" 'BEGIN{printf "%d", (m*60)+0.5}')
	expires=$(date -d "@$((now + secs))" '+%Y-%m-%d %H:%M:%S' 2>/dev/null || printf '+%ss' "$secs")
	printf 'sudo-elevation: 已授权 %s（至 %s）；窗口内 sudo -n 可直接执行\n' \
		"$(se_human_minutes "$minutes")" "$expires"
	[ "$minutes" = "0" ] && printf 'sudo-elevation: 本次授权为“仅本次”，下一条 sudo 仍会请求确认\n'
fi
[ "$reason_truncated" = 1 ] && printf 'sudo-elevation: 提示: 原因过长/含换行，已截断记录（最多200字符）\n' >&2
if [ "$restore_mech" = "failed" ]; then
	printf 'sudo-elevation: 警告: 无法安排到期自动恢复，配置仍受 sudo 自身超时保护\n' >&2
fi
