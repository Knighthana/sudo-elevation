#!/bin/bash
# sudo-elevation - user-facing CLI.
#
#   sudo-elevation request --for 2h --reason "..."   ask the user (GUI) for a lease
#   sudo-elevation grant   --for 1h [--reason ...]   terminal/headless approval path
#   sudo-elevation status                            show current lease / base window
#   sudo-elevation lock                              revoke immediately and restore base
#   sudo-elevation parse <spec>                      print minutes for a duration spec (debug)
set -euo pipefail

SELF_DIR=$(cd "$(dirname "$0")" && pwd)
# shellcheck source=../libexec/sudo-elevation/common.sh
. "$SELF_DIR/../libexec/sudo-elevation/common.sh"

ME=$(id -un)
GRANT_BIN="$SE_LIBEXEC/grant"
RESTORE_BIN="$SE_LIBEXEC/restore"

# sudo resolves the askpass helper from SUDO_ASKPASS, and `Path askpass` in
# sudo.conf is machine-global (one per host, honoured for every account). A
# user-channel helper is therefore reachable ONLY through this variable, so
# supply our own tree's copy when the caller has not picked one. Because the
# CLI self-locates, this always names the helper from the same tree as the CLI
# itself -- no $PATH guessing, no global file, no shell profile.
# Fallback, never an override: an explicit SUDO_ASKPASS still wins, which is
# what the test-suite's fake helpers and any deliberate user choice rely on.
if [ -z "${SUDO_ASKPASS:-}" ] && [ -x "$SE_BIN_DIR/sudo-askpass" ]; then
	export SUDO_ASKPASS="$SE_BIN_DIR/sudo-askpass"
fi

# The window currently in force. The lease file is 0600 and owned by this
# account, so it is readable without help from sudo, and its `minutes` key is
# exactly what grant wrote into the sudoers drop-in. The previous
# `sudo -n grep <0440 root-owned file>` needed a cached timestamp to work at
# all, so `status` reported an empty current_timeout whenever no lease was
# live -- exactly when a user most wants to see the base window.
se_current_timeout() { # lease_file
	local m
	m=$(se_read_kv "${1-}" minutes 2>/dev/null || true)
	printf '%s' "${m:-$BASE_MINUTES}"
}

# Which tree this CLI came from, and which config layer won each key. Without
# this, `sudo-elevation` on a host with both a system and a user install is
# opaque: $PATH decides which binary answers, and nothing says so.
se_provenance() {
	printf 'cli=%s\n' "$SE_BIN_DIR"
	printf 'askpass=%s\n' "${SUDO_ASKPASS:-none}"
	local layer file
	while IFS=$'\t' read -r layer file; do
		[ -n "$file" ] || continue
		[ -r "$file" ] || continue
		printf 'config[%s]=%s\n' "$layer" "$file"
	done < <(se_config_layers "$ME")
	# src_* so these cannot collide with the bare keys status already prints:
	# --porcelain output is machine-readable and duplicate keys are a bug.
	printf 'src_base_minutes=%s\n' "$BASE_MINUTES_SRC"
	printf 'src_max_minutes=%s\n' "$MAX_MINUTES_SRC"
	printf 'src_gui_backend=%s\n' "$GUI_BACKEND_SRC"
	printf 'src_dialog_timeout=%s\n' "$DIALOG_TIMEOUT_SRC"
}

usage() {
	cat <<'EOF'
usage: sudo-elevation <command> [options]

commands:
  request --for <duration> [--reason TEXT]   request a time-boxed sudo lease (GUI dialog)
  grant   --for <duration> [--reason TEXT]   approve a lease from a terminal (headless)
  status [--porcelain]                       show active lease and base window
  lock                                       revoke sudo cache and restore base window
  uninstall                            bare uninstall is interactive (lists every install, asks keep/purge/skip per tree)
  uninstall [--keep|--purge] ...         explicit mode is automatic (for scripts, never prompts, fail-fast);
                                         keep removes software but keeps config, purge also removes our own data
  uninstall --purge [--user-install] [--no-system] [--prefix DIR] [--user U] [--skill-dir D] [--dry-run]
                                         automatic removal of one tree (own data only, manifest fills in the rest)
  parse <duration>                           print minutes for a duration spec
  version                                    print version

duration spec (single value + single unit only): 90s | 45m | 2h | 1d | 45 (bare = minutes)
  | until-lock (-1). No composites: 1m30s is invalid, use 90s. Unparseable specs fail immediately.
reason: keep <=60 chars (hard-truncated with warning at 200).
--porcelain: machine-readable KV, one pair per line, split on the FIRST '=' (values are single-line).
EOF
}

cmd=${1:-help}
shift || true

case "$cmd" in
	request)
		spec=""
		reason=""
		while [ $# -gt 0 ]; do
			case "$1" in
				--for) spec=${2-}; shift 2 ;;
				--reason) reason=${2-}; shift 2 ;;
				-h|--help) usage; exit 0 ;;
				*) echo "request: unknown argument: $1" >&2; exit 2 ;;
			esac
		done
		[ -n "$spec" ] || { echo "request: --for is required (example: --for 2h)" >&2; exit 2; }
		minutes=$(se_parse_minutes "$spec") || { echo "request: bad duration: $spec (single value+unit: 90s/45m/2h/1d/bare-minutes/until-lock; 1m30s invalid, use 90s)" >&2; exit 2; }
		se_load_config "$ME"
		se_valid_minutes "$minutes" || {
			echo "request: duration out of range: $spec (max $MAX_MINUTES minutes; use until-lock for infinity)" >&2
			exit 2
		}
		requester=${SUDO_ELEVATION_REQUESTER:-}
		if [ -z "$requester" ]; then
			requester=$(ps -o comm= -p "$PPID" 2>/dev/null | tr -d ' ' || true)
		fi
		[ -n "$requester" ] || requester=unknown
		cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/sudo-elevation"
		mkdir -p "$cache_dir"
		chmod 0700 "$cache_dir" 2>/dev/null || true
		req_file="$cache_dir/request"
		choice_file="$cache_dir/choice"
		# One pending request per account. Two agents racing would otherwise
		# overwrite each other's request file, and the approval dialog would
		# then describe a request that is not the one being answered. mkdir is
		# the lock because it is atomic and needs no flock(1).
		lock_dir="$cache_dir/.request.lock"
		lock_wait=$((DIALOG_TIMEOUT > 300 ? DIALOG_TIMEOUT : 300))
		lock_stale=$((lock_wait + 120))
		lock_ok=0
		if mkdir "$lock_dir" 2>/dev/null; then
			lock_ok=1
		else
			# Break a stale lock: an agent killed mid-request leaves the
			# directory behind, and a lock nobody can clear is worse than a
			# clobbered request file. Age is taken from the lock itself so a
			# request that is merely slow is never stolen -- and the floor
			# keeps DIALOG_TIMEOUT=0 (no timeout) from expiring locks in 2
			# minutes.
			lock_age=$(( $(date +%s) - $(stat -c %Y "$lock_dir" 2>/dev/null || echo 0) ))
			if [ "$lock_age" -gt "$lock_stale" ] \
			   && rmdir "$lock_dir" 2>/dev/null \
			   && mkdir "$lock_dir" 2>/dev/null; then
				lock_ok=1
			fi
		fi
		if [ "$lock_ok" != 1 ]; then
			echo "request: 另一个 sudo-elevation request 正在等待审批（锁: $lock_dir）" >&2
			echo "  等它完成即可；若确认没有进程在等待（>${lock_stale}s），下次会自动接管" >&2
			exit 3
		fi
		{
			printf 'requested_minutes=%s\n' "$minutes"
			printf 'reason=%s\n' "$(se_sanitize_reason "$reason")"
			printf 'requester=%s\n' "$requester"
			printf 'ts=%s\n' "$(date +%s)"
		} > "$req_file"
		chmod 0600 "$req_file" 2>/dev/null || true
		rm -f "$choice_file"
		trap 'rm -f "$req_file" "$choice_file"; rmdir "$lock_dir" 2>/dev/null || true' EXIT
		rc=0
		# Force the approval dialog even when a cached timestamp would let sudo
		# skip it, without wiping an active lease's credentials if the user cancels:
		#   - timestamp valid   -> `sudo -k -A`: ignores the cache so askpass runs
		#                          (duration picker), but keeps the cache on cancel;
		#   - timestamp invalid -> `sudo -A`: prompts anyway; on success sudo
		#                          refreshes the cache so `sudo -n` works right after.
		if sudo -n true 2>/dev/null; then
			sudo -k -A "$GRANT_BIN" --user "$ME" --choice-file "$choice_file" --request-file "$req_file" --config-file "$SE_CONFIG" || rc=$?
		else
			sudo -A "$GRANT_BIN" --user "$ME" --choice-file "$choice_file" --request-file "$req_file" --config-file "$SE_CONFIG" || rc=$?
		fi
		if [ "$rc" != 0 ]; then
			# The likeliest cause is a scoped sudoers rule. This project only ever
			# writes Defaults (the time window) and never a command rule, so it
			# cannot widen anybody's permissions -- and it must not try. Spell the
			# requirement out instead of letting sudo's localised message be the
			# only clue.
			printf 'sudo-elevation: 授权未完成（rc=%s）。\n' "$rc" >&2
			printf '  若 sudo 报“不允许执行 / not allowed to execute”：当前账户的 sudo 被限定到少数命令。\n' >&2
			printf '  本项目只写 Defaults（时间窗），从不写命令规则、不碰 NOPASSWD，\n' >&2
			printf '  因此 request/grant 要求该账户已有宽权限 sudo；请改用宽权限账户，或由管理员放宽。\n' >&2
			printf '  放宽时请保持 %s 由 root 拥有且该账户不可写（它是经 sudo 以 root 执行的）。\n' \
				"$GRANT_BIN" >&2
		fi
		exit "$rc"
		;;
	grant)
		spec=""
		reason=""
		while [ $# -gt 0 ]; do
			case "$1" in
				--for) spec=${2-}; shift 2 ;;
				--reason) reason=${2-}; shift 2 ;;
				-h|--help) usage; exit 0 ;;
				*) echo "grant: unknown argument: $1" >&2; exit 2 ;;
			esac
		done
		[ -n "$spec" ] || { echo "grant: --for is required (example: --for 1h)" >&2; exit 2; }
		minutes=$(se_parse_minutes "$spec") || { echo "grant: bad duration: $spec (single value+unit: 90s/45m/2h/1d/bare-minutes/until-lock; 1m30s invalid, use 90s)" >&2; exit 2; }
		args=(--user "$ME" --minutes "$minutes" --config-file "$SE_CONFIG")
		[ -n "$reason" ] && args+=(--reason "$(se_sanitize_reason "$reason")")
		if [ -t 0 ] || [ -t 1 ]; then
			exec sudo "$GRANT_BIN" "${args[@]}"
		else
			# No terminal (agent): force askpass. On a real tty sudo will
			# prompt normally instead.
			exec sudo -A "$GRANT_BIN" "${args[@]}"
		fi
		;;
	status)
		porcelain=0
		while [ $# -gt 0 ]; do
			case "$1" in
				--porcelain) porcelain=1; shift ;;
				-h|--help) usage; exit 0 ;;
				*) echo "status: unknown argument: $1" >&2; exit 2 ;;
			esac
		done
		se_load_config "$ME"
		lease=$(se_lease_file "$ME")
		if [ -f "$lease" ]; then
			minutes=$(se_read_kv "$lease" minutes || true)
			epoch=$(se_read_kv "$lease" epoch || true)
			granted=$(se_read_kv "$lease" granted_at || true)
			restore=$(se_read_kv "$lease" restore || true)
			reason=$(se_read_kv "$lease" reason || true)
			if [ "$porcelain" = 1 ]; then
				# Machine-readable KV. remaining_s=-1 means infinite
				# (until-lock); 0 means expired-but-not-yet-restored.
				# Unparseable minutes are treated as 0 (fail closed).
				remaining_s=""
				if [ "$minutes" = "-1" ]; then
					remaining_s=-1
				elif [ -n "$minutes" ]; then
					case "$minutes" in ''|*[^0-9.]*|*.*.*|.*|*.) remaining_s=0 ;;
					*)
						start=${epoch%%-*}
						case "$start" in ''|*[!0-9]*) start=0 ;; esac
						now=$(date +%s)
						secs=$(awk -v m="$minutes" 'BEGIN{printf "%d", (m*60)+0.5}')
						rem=$((start + secs - now))
						[ "$rem" -lt 0 ] && rem=0
						remaining_s=$rem
						;;
					esac
				fi
				cur=$(se_current_timeout "$lease")
				printf 'active=1\nminutes=%s\nepoch=%s\ngranted_at=%s\nrestore=%s\nreason=%s\nremaining_s=%s\nbase_minutes=%s\ncurrent_timeout=%s\n' \
					"${minutes:-}" "${epoch:-}" "${granted:-}" "${restore:-none}" "${reason:-}" "$remaining_s" "$BASE_MINUTES" "${cur:-}"
				se_provenance
				exit 0
			fi
			printf '活动租约: %s\n' "$(se_human_minutes "${minutes:-?}")"
			printf '  原因: %s\n' "${reason:-未提供}"
			printf '  批准于: %s\n' "${granted:-?}"
			printf '  自动恢复: %s\n' "${restore:-none}"
			if [ "$minutes" != "-1" ]; then
				# epoch is a unique id "start-pid-random"; only the leading
				# timestamp is numeric ($((epoch ...)) would subtract the rest).
				start=${epoch%%-*}
				case "$start" in ''|*[!0-9]*) start=0 ;; esac
				now=$(date +%s)
				secs=$(awk -v m="$minutes" 'BEGIN{printf "%d", (m*60)+0.5}')
				exp=$((start + secs))
				if [ "$now" -lt "$exp" ]; then
					printf '  剩余: %s\n' "$(se_human_minutes "$(awk -v s="$((exp - now))" 'BEGIN{printf "%.4f", s/60}')")"
				else
					printf '  状态: 已到期（等待自动恢复任务）\n'
				fi
			fi
		else
			if [ "$porcelain" = 1 ]; then
				cur=$(se_current_timeout "$lease")
				printf 'active=0\nminutes=\nepoch=\ngranted_at=\nrestore=\nreason=\nremaining_s=\nbase_minutes=%s\ncurrent_timeout=%s\n' \
					"$BASE_MINUTES" "${cur:-}"
				se_provenance
				exit 0
			fi
			printf '无活动租约（基础窗口 %s）\n' "$(se_human_minutes "$BASE_MINUTES")"
		fi
		cur=$(se_current_timeout "$lease")
		if [ -n "$cur" ]; then
			printf '当前 sudoers 窗口: %s\n' "$(se_human_minutes "$cur")"
		fi
		printf '来源: %s\n' "$SE_BIN_DIR"
		_prov=$(se_provenance)
		while IFS= read -r _l; do
			case "$_l" in
				config*) printf '  %s\n' "$_l" ;;
			esac
		done <<<"$_prov"
		printf '  弹窗后端: %s\n' "$GUI_BACKEND"
		printf '  审批上限: %s\n' "$(se_human_minutes "$MAX_MINUTES")"
		exit 0
		;;
	lock)
		se_load_config "$ME"
		restored=0
		timed_out=0
		if sudo -n "$RESTORE_BIN" --user "$ME" --force --config-file "$SE_CONFIG" >/dev/null 2>&1; then
			restored=1
		elif [ -t 0 ] || [ -t 1 ]; then
			# Interactive fallback: no cached timestamp (e.g. after a bare
			# `sudo -k`), but the user is at a tty and can authenticate once
			# to actually remove the lease config. Wrapped in timeout so an
			# unattended pty (no human behind it) fails fast instead of
			# hanging on the password prompt: a hang costs more than an error.
			# (case with no match returns 0, keeping this safe under set -e.)
			if timeout 15 sudo "$RESTORE_BIN" --user "$ME" --force --config-file "$SE_CONFIG" >/dev/null 2>&1; then
				restored=1
			else
				case "$?" in 124) timed_out=1 ;; esac
			fi
		fi
		sudo -k 2>/dev/null || true
		if [ "$restored" = 1 ]; then
			printf 'sudo-elevation: 已撤销缓存并恢复基础窗口 %s\n' "$(se_human_minutes "$BASE_MINUTES")"
			exit 0
		fi
		lease_minutes=$(se_read_kv "$(se_lease_file "$ME")" minutes 2>/dev/null || true)
		if [ "$timed_out" = 1 ]; then
			printf 'sudo-elevation: lock 认证超时（15s 无输入），请重试 lock\n' >&2
		fi
		if [ "$lease_minutes" = "-1" ]; then
			cat >&2 <<EOF
sudo-elevation: lock 失败：until-lock 配置仍在（timestamp_timeout=-1）。
sudo -k 只清本次缓存，下次任意密码认证会直接获得无限期免密。
请在有 tty 的终端执行一次 sudo -k 之后的 \`sudo sudo-elevation lock\` 或
\`sudo /usr/local/libexec/sudo-elevation/restore --user $ME --force\`（输密码即根治）。
EOF
			printf 'sudo-elevation: 已撤销当前 sudo 缓存，但 until-lock 配置仍在，需尽快在终端补 lock（见上方 stderr）\n'
			exit 1
		fi
		printf 'sudo-elevation: 已撤销当前 sudo 缓存；配置将在定时恢复/下次授权时回到基础窗口（sudo 超时仍会保护）\n'
		;;
  uninstall)
		fwd=()
		explicit=0
		explicit_ui=0
		keep_seen=0
		purge_seen=0
		while [ $# -gt 0 ]; do
			case "$1" in
				--purge) fwd+=(--purge); explicit=1; purge_seen=1; shift ;;
				--all-users) fwd+=(--all-users); explicit=1; shift ;;
				--keep) fwd+=(--keep); explicit=1; keep_seen=1; shift ;;
				--user-install) fwd+=(--user-install); explicit=1; explicit_ui=1; shift ;;
				--no-system) fwd+=(--no-system); explicit=1; shift ;;
				--prefix) [ $# -ge 2 ] || { echo "uninstall: --prefix needs a value" >&2; exit 2; }; fwd+=(--prefix "$2"); explicit=1; shift 2 ;;
				--user) [ $# -ge 2 ] || { echo "uninstall: --user needs a value" >&2; exit 2; }; fwd+=(--user "$2"); explicit=1; shift 2 ;;
				--skill-dir) [ $# -ge 2 ] || { echo "uninstall: --skill-dir needs a value" >&2; exit 2; }; fwd+=(--skill-dir "$2"); explicit=1; shift 2 ;;
				--dry-run|-n) fwd+=(--dry-run); explicit=1; shift ;;
				-h|--help) usage; exit 0 ;;
				*) echo "uninstall: unknown argument: $1" >&2; exit 2 ;;
			esac
		done
		if [ "$keep_seen" = 1 ] && [ "$purge_seen" = 1 ]; then
			echo "uninstall: --keep cannot be combined with --purge" >&2
			exit 2
		fi
		installer="$SE_LIBEXEC/install.sh"
		if [ ! -f "$installer" ]; then
			echo "uninstall: $installer not found (install first, or run ./install.sh --uninstall from the repository)" >&2
			exit 1
		fi
		if [ "$explicit" = 0 ]; then
			# Interactive: the installer owns discovery. Auth first when a
			# terminal is present; otherwise list without touching anything.
			if [ -t 0 ] || [ -t 1 ]; then
				exec sudo "$installer" --uninstall
			elif sudo -n true 2>/dev/null; then
				exec sudo -n "$installer" --uninstall
			else
				exec "$installer" --uninstall
			fi
		fi
		# Automatic (unattended/script): explicit flags win, the manifest
		# fills in the rest. Fail fast: never hang on a password prompt.
		# Re-apply the recorded install layout (user-install without exports).
		# A user install is receipt-located and never needs --prefix, even
		# when SUDO_ELEVATION_PREFIX leaks in from a test shell: prefer the
		# manifest layout over the env prefix so we never uninstall the
		# wrong tree (or die on --prefix + --user-install).
		user_mode=$explicit_ui
		if [ -f "$SE_SHARE/manifest" ]; then
			if [ "$(se_read_kv "$SE_SHARE/manifest" INSTALL_MODE || true)" = user ]; then
				user_mode=1
				[ "$explicit_ui" = 1 ] || fwd+=(--user-install)
			fi
			if [ "$(se_read_kv "$SE_SHARE/manifest" SYSTEM || true)" = 0 ]; then
				has_ns=0
				for f in ${fwd[@]+"${fwd[@]}"}; do
					[ "$f" = "--no-system" ] && has_ns=1
				done
				[ "$has_ns" = 0 ] && fwd+=(--no-system)
			fi
		fi
		if [ -n "${SUDO_ELEVATION_PREFIX:-}" ] && [ "$user_mode" = 0 ]; then
			exec "$installer" --prefix "$SUDO_ELEVATION_PREFIX" --uninstall "${fwd[@]}"
		fi
		is_dry=0
		for f in ${fwd[@]+"${fwd[@]}"}; do
			[ "$f" = "--dry-run" ] && is_dry=1
		done
		if sudo -n true 2>/dev/null; then
			exec sudo -n "$installer" --uninstall "${fwd[@]}"
		elif [ "$is_dry" = 1 ]; then
			echo "uninstall: no valid sudo timestamp; dry-run preview may be partial." >&2
			exec "$installer" --uninstall "${fwd[@]}"
		else
			echo "uninstall (automatic): no valid sudo timestamp; run sudo -v first," >&2
			echo "or run bare 'sudo-elevation uninstall' on a terminal for interactive removal." >&2
			exit 1
		fi
		;;
	parse)
		se_parse_minutes "${1-}" || { echo "parse: bad duration: ${1-} (single value+unit: 90s/45m/2h/1d/bare-minutes/until-lock; 1m30s invalid, use 90s)" >&2; exit 2; }
		printf '\n'
		;;
	version)
		printf 'sudo-elevation %s\n' "$SE_VERSION"
		;;
	help|-h|--help)
		usage
		;;
	*)
		echo "sudo-elevation: unknown command: $cmd" >&2
		usage
		exit 2
		;;
esac
